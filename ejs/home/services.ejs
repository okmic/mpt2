<div id="services" class="services bg-gray-100 py-10">
    <div class="titleServices text-center mb-8">
        <span class="whiteBorder text-3xl md:text-4xl font-bold">УСЛУГИ</span>
    </div>
    <div class="max-w-6xl mx-auto px-4">
        <% content.services.forEach(service => { %>
            <div class="serviceItem bg-blue-50 border-l-4 border-blue-500 shadow-md rounded-lg p-6 mb-6 transition-transform transform hover:shadow-lg">
                <h3 class="text-xl md:text-2xl font-semibold text-blue-700"><%= service.title %></h3>
                <p class="text-gray-700 mb-2"><%= service.description %></p>
                <ul class="list-disc list-inside text-gray-700">
                    <% service.items.forEach(item => { %>
                        <li class="text-base md:text-lg"><%= item.text %></li>
                    <% }); %>
                </ul>
            </div>
        <% }); %>
    </div>
</div>
