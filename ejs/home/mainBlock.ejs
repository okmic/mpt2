<div class="flex items-center justify-center min-h-screen w-screen bg-gray-100">
    <div class="flex flex-col md:flex-row w-full max-w-6xl h-auto md:h-screen py-[30%]"> <!-- Отступы по Y: 30% для больших экранов -->
        <div class="flex-1 flex justify-center items-center order-1 md:order-2">
            <img src="<%= content.mainBlockImgUrl %>" alt="Main Img" class="w-full max-w-[500px] h-auto object-contain rounded-lg md:rounded-none">
        </div>
        <div class="flex-1 flex flex-col justify-center items-center order-2 md:order-1 mt-[25%] md:mt-[30%]"> <!-- Отступ сверху между изображением и текстом -->
            <h1 class="text-3xl md:text-5xl font-bold mb-4 text-center"><%= content.mainBlockTitle %></h1>
            <p class="text-gray-700 mb-6 text-base md:text-lg text-center"><%= content.mainBlockDescription %></p>
            <div class="flex space-x-4">
                <a href="#how-it-works"><button class="bg-transparent text-blue-500 rounded-lg px-6 py-3 hover:bg-blue-500 hover:text-white transition duration-300 text-base md:text-lg">О компании</button></a>
                <a href="/products"><button class="bg-blue-500 text-white rounded-lg px-6 py-3 hover:bg-blue-600 transition duration-300 text-base md:text-lg">Продукты</button></a>
            </div>
        </div>
    </div>
</div>
