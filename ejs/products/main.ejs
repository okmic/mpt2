<main class="container mx-auto px-4 py-8">
    <h2 class="text-3xl font-semibold mb-6 text-center">Наши продукты</h2>
    <% if (content.products.length === 0) { %>
        <p class="text-center text-gray-600">Нет доступных продуктов.</p>
    <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% content.products.forEach(product => { %>
                <div class="bg-white rounded-lg shadow-lg overflow-hidden transition-transform transform hover:scale-105 shadow-md hover:shadow-xl" id="product-<%= product.id %>">
                    <div class="relative aspect-w-16 aspect-h-9">
                        <img src="<%= product.imgUrl %>" alt="<%= product.title %>" class="object-contain w-full h-full transition-transform duration-200 transform hover:scale-110">
                    </div>
                    <div class="p-4">
                        <h3 class="text-lg font-semibold text-gray-800 hover:text-blue-600 transition duration-200"><%= product.title %></h3>
                        <p class="text-gray-600 mt-2"><%= product.description %></p>
                        <div class="flex justify-between items-center mt-4">
                            <span class="text-xl font-bold text-blue-600">₽<%= product.price %></span>
                            <button class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 transition duration-200 flex items-center shadow-sm hover:shadow-md" onclick="addToCart('<%= product.id %>', '<%= product.title %>', '<%= product.price %>')">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h18l-1.5 9H5.25L3 3z" />
                                </svg>
                                Купить
                            </button>
                        </div>
                        <p class="text-green-600 mt-2 quantity-display" style="display: none;">В корзине: <span class="quantity"></span></p>
                    </div>
                </div>
            <% });%>
        </div>
    <% } %>
</main>

<div class="fixed bottom-4 right-4">
    <button id="open-cart" class="bg-blue-500 text-white p-3 rounded-full shadow-lg hover:bg-blue-600 transition duration-200">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h18l-1.5 9H5.25L3 3z" />
        </svg>
        <span id="cart-count" class="absolute -top-1 -right-1 bg-red-500 text-white rounded-full px-2 text-xs"></span>
    </button>
</div>

<!-- Модальное окно для корзины -->
<div id="cart-modal" class="fixed inset-0 bg-gray-800 bg-opacity-75 flex justify-center items-center hidden">
    <div class="bg-white rounded-lg p-6 w-80 md:w-96">
        <h3 class="text-xl font-semibold mb-4">Корзина</h3>
        <ul id="cart-items" class="mt-2 max-h-60 overflow-y-auto"></ul>
        <div class="flex justify-between mt-4">
            <span class="font-semibold">Итого:</span>
            <span id="total-price" class="font-bold">₽0</span>
        </div>
        <button id="clear-cart" class="mt-4 bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600 transition duration-200">Очистить корзину</button>
        <button id="checkout" class="mt-2 bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 transition duration-200 w-full">Перейти к оформлению</button>
        <button id="close-modal" class="mt-2 bg-gray-300 text-black px-4 py-2 rounded hover:bg-gray-400 transition duration-200 w-full">Закрыть</button>
    </div>
</div>