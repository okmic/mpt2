<button id="openModalButton" class="bg-blue-600 text-white rounded-lg px-4 py-2 hover:bg-blue-700 transition duration-300">
    Оставить заявку
</button>

<div id="modal-feed-back" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-70 hidden">
    <div class="bg-gray-800 rounded-lg shadow-lg p-6 w-96">
        <h3 class="text-xl font-bold mb-4 text-white">Оставьте заявку</h3>
        <form id="modalDataCollector" class="space-y-4">
            <div>
                <label for="modalName" class="block text-sm font-semibold text-gray-300">Имя:</label>
                <input type="text" id="modalName" name="name" required class="mt-1 p-2 border border-gray-600 rounded w-full bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label for="modalEmail" class="block text-sm font-semibold text-gray-300">Email:</label>
                <input type="email" id="modalEmail" name="email" required class="mt-1 p-2 border border-gray-600 rounded w-full bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label for="modalPhone" class="block text-sm font-semibold text-gray-300">Номер телефона:</label>
                <input type="tel" id="modalPhone" name="phone" required pattern="[0-9]{10}" title="Введите 10-значный номер телефона без пробелов и символов" class="mt-1 p-2 border border-gray-600 rounded w-full bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div class="flex justify-end">
                <button type="button" id="closeModalButton" class="bg-gray-600 text-white rounded-lg px-4 py-2 hover:bg-gray-500 transition duration-300 mr-2">Закрыть</button>
                <button type="submit" class="bg-blue-600 text-white rounded-lg px-4 py-2 hover:bg-blue-700 transition duration-300">Отправить</button>
            </div>
        </form>
    </div>
</div>